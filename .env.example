# ── Blessed front end config ─────────────────────────────────────────────
# Leave the contract addresses blank to run in DEMO MODE (mock data + fake txs).

# Backend / indexer REST API (pairs, trades, holders, stats, earnings…)
NEXT_PUBLIC_API_URL=

# WalletConnect Cloud project id (https://cloud.reown.com)
